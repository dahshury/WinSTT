{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "tabOrder", "nonInteractivePaths", "tabs"],
  "properties": {
    "version": { "const": 1 },
    "tabOrder": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "nonInteractivePaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string", "minLength": 12 }
        },
        "additionalProperties": false
      }
    },
    "tabs": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "rawControlBaseline",
          "smokeSelectors",
          "items"
        ],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "rawControlBaseline": {
            "type": "object",
            "required": ["observed", "minimum"],
            "properties": {
              "observed": { "type": "integer", "minimum": 1 },
              "minimum": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "smokeSelectors": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/selector" }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "label",
                "selector",
                "settingsPaths",
                "availability",
                "safety",
                "source"
              ],
              "properties": {
                "id": { "type": "string" },
                "kind": { "enum": ["control", "action"] },
                "label": { "type": "string" },
                "selector": { "$ref": "#/$defs/selector" },
                "settingsPaths": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "availability": { "type": "string" },
                "safety": { "type": "string" },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["role", "name"],
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
